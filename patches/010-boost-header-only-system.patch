Boost.System is header-only and its stub library was removed in Boost 1.89.
Use the Boost CMake package installed by the OpenWrt feed and its imported
targets, which also supply the include paths for header-only libraries.
For cross builds, restrict package discovery to the target roots so missing
target components cannot fall back to the host's Boost libraries.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -39,6 +39,8 @@
-find_package(Boost 1.66.0 REQUIRED COMPONENTS system program_options)
-include_directories(${Boost_INCLUDE_DIR})
-target_link_libraries(trojan ${Boost_LIBRARIES})
+if(CMAKE_CROSSCOMPILING)
+    set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
+endif()
+find_package(Boost 1.70.0 CONFIG REQUIRED COMPONENTS program_options)
+target_link_libraries(trojan Boost::headers Boost::program_options)
 if(MSVC)
     add_definitions(-DBOOST_DATE_TIME_NO_LIB)
 endif()
